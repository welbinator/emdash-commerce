{
  "name": "emdash-commerce",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node -e \"const fs=require('fs');const c=JSON.parse(fs.readFileSync('dist/server/wrangler.json','utf8'));if(c.assets)c.assets.binding='SITE_ASSETS';fs.writeFileSync('dist/server/wrangler.json',JSON.stringify(c));console.log('Patched ASSETS binding')\"",
    "preview": "astro preview",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.6",
    "@astrojs/react": "7.1.4",
    "@emdash-cms/cloudflare": "1.4.0",
    "@iconify-json/ph": "1.2.2",
    "astro": "7.4.7",
    "astro-iconset": "0.0.6",
    "emdash": "1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261107.1",
    "lightningcss": "^1.0.0",
    "wrangler": "4.158.0"
  }
}
