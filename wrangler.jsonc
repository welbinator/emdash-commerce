{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emdash-commerce",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emdash-commerce-db",
      "database_id": "76d10832-e5f3-42e7-8da7-4422d1cdb51f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "emdash-commerce-media"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
